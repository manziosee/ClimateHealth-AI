# App
APP_ENV=development
SECRET_KEY=change-me-in-production

# Authentication
# Master admin key — use this to call POST /api/v1/admin/keys to create user keys
# Generate with: python -c "import secrets; print('cha_admin_' + secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Observability (optional — error tracking disabled when not set)
# Create a free project at https://sentry.io and paste the DSN here
SENTRY_DSN=

# Neon PostgreSQL — asyncpg uses ssl=require NOT sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Redis
REDIS_URL=redis://redis:6379/0

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1
WHO_BASE_URL=https://ghoapi.azureedge.net/api
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2

# Cache TTL (seconds)
WEATHER_CACHE_TTL=1800
PREDICTION_CACHE_TTL=3600
DISEASE_CACHE_TTL=86400

# AI Services (optional — endpoints return 503 when not set)
# Groq Cloud — https://console.groq.com/keys
GROQ_API_KEY=
# Hugging Face Inference API — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Notification Services (optional — alerts skipped when not set)
# SendGrid — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=alerts@climatehealth.ai
# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
